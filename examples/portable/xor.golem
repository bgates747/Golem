// XOR toggles the bits selected by the mask. Compile with --portable.
uint16 flags = 5
uint16 mask = 3
uint16 toggled = 0
sint32 signedValue = -1
sint32 signMask = -2147483648
sint32 signedResult = 0
bool anySet = false
Sub toggle
    toggled = flags ^ mask
    signedResult = signedValue ^ signMask
    anySet = toggled != 0
EndSub
