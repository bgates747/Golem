// Design scratch program, not an executable fixture: print str(qux) still
// requires an unimplemented uint16-to-string conversion. Declarations,
// addition and For/Next are implemented. No statement terminators.
uint16 foo = 10
uint16 bar = 5
uint16 qux
qux = foo + bar
print str(qux)

// This independent loop example does compile. The counter must be declared.
uint16 i
For i = 1 To 50
    print "Hello "
Next i
