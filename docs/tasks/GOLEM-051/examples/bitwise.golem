// Compile with --portable. All calculations and printing run on stock VDP.
uint16 flags = 5
uint16 mask = 3
uint16 both = 0
uint16 either = 0
uint16 different = 0
uint16 inverted = 0
Sub inspectBits
    both = flags & mask
    either = flags | mask
    different = flags ^ mask
    inverted = ~flags
    print "and=" print str(both)
    print " or=" print str(either)
    print " xor=" print str(different)
    print " not=" print str(inverted)
EndSub
