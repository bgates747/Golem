// Syntax illustrations for review; this whole file does not compile yet.
// No statement terminators. For/Next is implemented in the main compiler.
// Boolean comparisons, If/Else, Do loops and Switch remain proposed.
// Independent samples: each includes its own declarations and initial state.

// Boolean initialization from comparisons (proposed)
uint16 foo = 1
uint16 bar = 2

bool quux = foo != bar         // true
bool equal = foo == bar        // false
bool less = foo < bar          // true
bool greater = foo > bar       // false
bool lessOrEqual = foo <= bar  // true
bool greaterOrEqual = foo >= bar // false

// Reassign a boolean using another comparison
quux = foo == bar              // false


// Branching
sint16 result = -1

If result < 0 Then
    print "negative"
ElseIf result == 0 Then
    print "zero"
Else
    print "positive"
EndIf


// Selection: evaluate once, no fall-through, optional Default
uint16 direction = 1

Switch direction
Case 0
    print "north"
Case 1
    print "east"
Case 2
    print "south"
Case 3
    print "west"
Default
    print "unknown"
EndSwitch


// Indexed dispatch: inclusive consecutive slots, any starting value
// TODO implementation: Range requests a bounds-checked resident jump table.
// Missing Case 0 and out-of-range values both use Default, without a warning.
// Without Default, those values continue after EndSwitch.
// Duplicate/out-of-range cases and oversized tables are compile-time errors.
sint16 turn = -1

Switch turn Range(-2:2)
Case -2
    print "hard left"
Case -1
    print "left"
Case 1
    print "right"
Case 2
    print "hard right"
Default
    print "neutral or unknown"
EndSwitch

// Possible later extension, not yet selected: Range(2:10:2).
// This would cover 2, 4, 6, 8, 10 and require a step-alignment check.


// Selected Range spelling; parser support remains pending.
// Range has inclusive limits; default step is 1. It need not create an array.
sint16 rangeIndex

For rangeIndex In Range(2:10:2)
    print "ascending tick"
Next rangeIndex

// Independent descending iteration; the loop assigns its initial counter value.
sint16 descendingIndex

For descendingIndex In Range(10:2:-2)
    print "descending tick"
Next descendingIndex


// Membership checks bounds AND step alignment: 6 belongs, 7 does not.
sint16 value = 6

If value In Range(2:10:2) Then
    print "member"
Else
    print "outside or between steps"
EndIf


// Stepped jump-table extension: slots for 2, 4, 6, 8, 10.
// Missing cases 4 and 8, nonmembers, and out-of-bounds values use Default.
uint16 direction = 6

Switch direction Range(2:10:2)
Case 2
    print "first"
Case 6
    print "third"
Case 10
    print "fifth"
Default
    print "unhandled"
EndSwitch


// Numeric bounds are not stepped sequences: 0.25 is permitted here.
// Bounds constrains numeric values; Range describes discrete indices/sequences.
float32 boundedInput Bounds(-1, 1) = 0.25


// Counted loop: inclusive endpoints, increment of 1
uint16 i

For i In Range(1:8)
    print "tick"
Next i


// A branch inside a loop
uint16 i

For i In Range(1:8)
    If i == 4 Then
        print "halfway"
    Else
        print "tick"
    EndIf
Next i


// Test before each iteration; continue while true
uint16 count = 0

Do While count < 4
    print "tick"
    count = count + 1
Loop


// Test before each iteration; stop when true
uint16 count = 0

Do Until count == 4
    print "tick"
    count = count + 1
Loop


// Test after each iteration; always run at least once, continue while true
uint16 count = 0

Do
    print "tick"
    count = count + 1
Loop While count < 4


// Test after each iteration; always run at least once, stop when true
uint16 count = 0

Do
    print "tick"
    count = count + 1
Loop Until count == 4


// GOLEM-009 additions for review. Each section below is independent.
// Except EX-006, these are proposed syntax, not executable compiler support.
// Semantics and domains: docs/tasks/GOLEM-009/semantics-review.md (accepted direction).
// GOLEM-010 adds storage/index/copy proposals below; typed drawing remains deferred.


// EX-001 — Typed integer values, ordinary copying and unsigned widening (proposed)
uint8 small = 200
uint16 full = 65535
sint16 signedValue = -12
sint32 large = 100000
uint16 copied = 0
sint16 widenedByte = 0
sint32 widenedWord = 0

copied = full
widenedByte = sint16(small)
widenedWord = sint32(full)


// EX-002 — Fixed-point values and explicit float loads (proposed)
// Candidate notation: signed total width, with 8 fractional bits.
fixed16(8) quarter = -1.25
fixed32(8) distance = 123.5
float32 quarterFloat = 0.0
float32 distanceFloat = 0.0

quarterFloat = float32(quarter)
distanceFloat = float32(distance)


// EX-003 — Float copy, signed input conversion, arithmetic and scaling (proposed)
float32 left Bounds(-10, 10) = -2.5
float32 right Bounds(-10, 10) = 4.0
sint32 count Bounds(0, 100) = 3
float32 copied = 0.0
float32 countFloat = 0.0
float32 sum = 0.0
float32 difference = 0.0
float32 product = 0.0
float32 scaled = 0.0

copied = left
countFloat = float32(count)
sum = left + right
difference = left - right
product = left * right
scaled = left * 0.5


// EX-004 — Bounded reciprocal and division through multiplication (proposed)
// The denominator's declared range excludes zero.
float32 numerator Bounds(-8, 8) = 6.0
float32 denominator Bounds(1, 4) = 2.0
float32 inverse = 0.0
float32 quotient = 0.0

inverse = reciprocal(denominator)
quotient = numerator * inverse


// EX-005 — Float-valued rounding and absolute value (proposed)
// For -2.5: floor=-3, trunc=-2, round_away=-3, abs=2.5.
float32 value Bounds(-10, 10) = -2.5
float32 floored = 0.0
float32 truncated = 0.0
float32 rounded = 0.0
float32 magnitude = 0.0

floored = floor(value)
truncated = trunc(value)
rounded = round_away(value)
magnitude = abs(value)


// EX-006 — Supported resident floor/conversion slice: compile separately --resident
// Legacy Range value bounds retained for the current parser; proposals use Bounds.
float32 x Range(-32768, 32767) = -0.00006103515625
sint16 result
Sub compute
    result = sint16(floor(x))
EndSub


// EX-007 — Bounded float-to-unsigned-word conversion after floor (proposed)
// This Rally-backed path excludes 65535; it is not a general cast.
float32 x Bounds(0, 65534) = 123.75
uint16 result = 0

result = uint16(floor(x))


// EX-008 — Bounded nonnegative float-to-signed32 conversion (proposed)
// This path covers 0..16777215, not arbitrary signed32 conversion.
float32 x Bounds(0, 16777215) = 123456.75
sint32 result = 0

result = sint32(floor(x))


// EX-009 — Constant-divisor quotient and remainder together (proposed)
// First two arguments are outputs. Here 100 / 7 gives quotient 14, remainder 2.
sint32 dividend Bounds(0, 1000) = 100
uint16 quotient = 0
uint16 remainder = 0

divmod_positive(quotient, remainder, dividend, 7)


// EX-010 — Matrix values, typed copy/load, extraction and cell replacement (proposed)
// Values are row-major. Submatrix origins and cell coordinates are zero-based.
matrix(2,2) source = matrix_values(1.0, 2.0, 3.0, 4.0)
matrix(2,2) copied = matrix_values(0.0, 0.0, 0.0, 0.0)
matrix(1,2) firstRow = matrix_values(0.0, 0.0)
matrix(2,2) changed = matrix_values(0.0, 0.0, 0.0, 0.0)

copied = source
firstRow = submatrix(copied, 0, 0, 1, 2)
changed = with_element(copied, 1, 0, 9.0)


// EX-011 — Matrix arithmetic (proposed)
// Matrix * matrix is a matrix product. Matrix * scalar scales every element.
matrix(2,2) left = matrix_values(1.0, 2.0, 3.0, 4.0)
matrix(2,2) right = matrix_values(5.0, 6.0, 7.0, 8.0)
matrix(2,2) sum = matrix_values(0.0, 0.0, 0.0, 0.0)
matrix(2,2) difference = matrix_values(0.0, 0.0, 0.0, 0.0)
matrix(2,2) product = matrix_values(0.0, 0.0, 0.0, 0.0)
matrix(2,2) scaled = matrix_values(0.0, 0.0, 0.0, 0.0)

sum = left + right
difference = left - right
product = left * right
scaled = left * 0.5


// EX-012 — Identity and geometric composition (proposed)
// Apply scale, then degree rotation, then translation to points.
float32 scaleX Bounds(1, 4) = 2.0
float32 scaleY Bounds(1, 4) = 2.0
float32 angle Bounds(-90, 90) = 45.0
float32 offsetX Bounds(-10, 10) = 2.0
float32 offsetY Bounds(-10, 10) = 3.0
matrix(3,3) transform = identity(3)

transform = scale(transform, scaleX, scaleY)
transform = rotate_degrees(transform, angle)
transform = translate(transform, offsetX, offsetY)


// EX-013 — Qualified diagonal affine inverse (proposed)
// Restricted to nonzero diagonal entries; not an arbitrary matrix inverse.
matrix(3,3) diagonal = matrix_values(2.0, 0.0, 0.0,
                                    0.0, 4.0, 0.0,
                                    0.0, 0.0, 1.0)
matrix(3,3) inverse = identity(3)

inverse = invert_affine(diagonal)


// EX-014 — Transform float point tuples without drawing or data indexing (proposed)
// Each row is an (x,y) point with implicit homogeneous 1. No perspective divide.
matrix(2,2) points = matrix_values(1.0, 2.0, 3.0, 4.0)
matrix(2,2) moved = matrix_values(0.0, 0.0, 0.0, 0.0)
matrix(3,3) transform = identity(3)

transform = translate(transform, 2.0, 3.0)
transform_points(moved, points, transform)


// EX-015 — Persistent state, finite resident work and source calls (proposed)
// Host invokes work after installation; globals initialize once and persist.
uint16 enabled = 1
uint16 calls = 0
uint16 i = 0
Sub tick
    calls = calls + 1
EndSub
Sub work
    For i In Range(1:8)
        If enabled == 1 Then
            tick()
        EndIf
    Next i
EndSub


// EX-016 — Sticky runtime admission for integer values (proposed)
// Failure clears valid; later successful checks do not restore it. Reset per job.
sint16 reading = 21
sint16 expected = 21
bool valid = true
Sub validate
    valid = true
    require_range(reading, 0, 20, valid)
    require_equal(reading, expected, valid)
    If valid Then
        print "accepted"
    Else
        print "rejected"
    EndIf
EndSub


// EX-017 — Explicit conversions between numeric types (proposed)
// For parameterized targets, candidate spelling is convert(targetType, value).
// Review recommends truncation for precision loss and checked out-of-range failure.
sint16 integerValue = -12
float32 floatValue = -2.0
fixed16(4) coarse = -1.25
fixed16(8) fine = 0.0
fixed32(8) wide = 0.0
fixed16(8) fixedFromInteger = 0.0
fixed16(4) fixedFromFloat = 0.0
float32 floatFromInteger = 0.0
float32 floatFromFixed = 0.0
sint16 integerFromFloat = 0
sint16 integerFromFixed = 0

fine = convert(fixed16(8), coarse)
wide = convert(fixed32(8), fine)
coarse = convert(fixed16(4), wide)
fixedFromInteger = convert(fixed16(8), integerValue)
fixedFromFloat = convert(fixed16(4), floatValue)
floatFromInteger = float32(integerValue)
floatFromFixed = float32(fine)
integerFromFloat = sint16(floatValue)
integerFromFixed = sint16(coarse)


// EX-018 — Three-dimensional Array; proposed access, implementation pending.
// Assembly installs 800 float32 zeros and the emitted scalar initializers first.
Array float32 readings(0:3, 0:9, 0:19)
uint16 first = 2
uint16 second = 5
uint16 third = 7
float32 selected = 1.0
Sub sampleReading
    readings(first, second, third) = 42.0
    selected = readings(first, second, third)
EndSub

// EX-019 — Selected stepped iteration; last value 65528, stop before wraparound.
uint16 sampleIndex
For sampleIndex In Range(0:65535:8)
    print "sample"
Next sampleIndex


// EX-020 — Function and scope proposals; passing/ownership await review.
uint16 calls = 0
Function twice(uint16 value) As uint16
    uint16 result = value * 2
    calls = calls + 1
    Return result
EndFunction
uint16 answer = twice(7)


// EX-021 — Multiple typed results; runtime integer division is new backend work.
Function divide(uint16 numerator, uint16 denominator) As (uint16, uint16)
    uint16 q = 0
    uint16 r = 0
    (q, r) = divmod(numerator, denominator)
    Return q, r
EndFunction
uint16 quotient = 0
uint16 remainder = 0
(quotient, remainder) = divide(17, 5)


// EX-022 — Signed paired quotient/remainder (proposed); uint16 resident divmod exists.
sint16 numerator = -17
sint16 denominator = 5
sint16 quotient = 0
sint16 remainder = 0
(quotient, remainder) = divmod(numerator, denominator)


// GOLEM-010: EX-023 through EX-028 remain proposed storage/access/copy syntax.
// Each block stands alone. Assembly installs data/initial state, updates and calls.
// File mappings and generated assembly interface notes: docs/tasks/GOLEM-010/examples-review.md.

// EX-023 — Opaque resident asset; assembly supplies its configured payload.
// Build maps everyByte to the 256 bytes 0 through 255; resident data is read-only.
Asset everyByte(256)


// EX-024 — Select a complete mixed-field table row in one assignment.
// Assembly installs four packed sint32 pairs: (7,9), (-4,6), (31,2), (80,1).
Record Sample
    sint32 a Bounds(-100, 100)
    sint32 b Bounds(1, 10)
EndRecord
Table Sample samples(0:3)
Sample selected = Sample(0, 1)
uint16 index = 2
Sub fetch
    selected = samples(index)
    print "selected"
EndSub


// EX-025 — Inclusive signed bounds; -1 selects the second element, not the last.
// Assembly installs four sint16 values 10, 20, 30, 40 and scalar initial state.
Array sint16 values(-2:1)
sint16 index = -1
sint16 selected = 99
Sub fetch
    selected = values(index)
EndSub


// EX-026 — Checked scalar assignment: out-of-bounds raw preserves depth, ends job.
uint16 raw = 1200
uint16 depth Bounds(64, 1100) = 64
Sub acceptDepth
    depth = raw
    print "accepted"
EndSub


// EX-027 — Copy a whole record, or update one field; same-type value semantics.
// Assembly installs the emitted initializers; host updates need admission checks.
Record Sample
    uint16 tag
    uint16 depth Bounds(64, 1100)
EndRecord
Sample incoming = Sample(7, 100)
Sample accepted = Sample(0, 64)
uint16 rawDepth = 100
Sub acceptSample
    accepted = incoming
    print "accepted"
EndSub
Sub acceptDepthField
    accepted.depth = rawDepth
EndSub


// EX-028 — Indexed mutable Array store; failed index/expression leaves slot unchanged.
// Assembly installs four uint16 zeros plus the emitted index/value initializers.
Array uint16 values(10:13)
uint16 index = 11
uint16 raw = 24
Sub storeValue
    values(index) = raw + 1
EndSub


// EX-029 — Supported small typed table job: compile separately --resident.
// PC build: --table-data samples=docs/tasks/GOLEM-017/records.dat --emit-asm
// Assembly sends the bootstrap, updates index and calls golem_fetch.
// Rows are (1,-2), (2,3), (3,-4), (4,5); invalid index preserves selected.
Record Sample
    uint16 tag
    sint16 delta
EndRecord
Table Sample samples(0:3)
Sample selected = Sample(65535, -32768)
uint16 index = 0
Sub fetch
    selected = samples(index)
    print "selected\n"
EndSub
