uint16 n = 100
uint16 d = 7
uint16 q = 19
uint16 r = 23
uint16 smallQ Bounds(0,10) = 3
uint16 smallR Bounds(0,5) = 4
uint16 earlier = 7
uint16 i = 0
Sub divide
    earlier = earlier + 1
    (q, r) = divmod(n, d)
    earlier = earlier + 1
EndSub
Sub aliasInputs
    (n, d) = divmod(n, d)
EndSub
Sub reverseAlias
    (d, n) = divmod(n, d)
EndSub
Sub expressions
    earlier = earlier + 1
    (q, r) = divmod(n + 1, d - 1)
    earlier = earlier + 1
EndSub
Sub bounded
    earlier = earlier + 1
    (smallQ, smallR) = divmod(n, d)
    earlier = earlier + 1
EndSub
Sub repeated
    For i In Range(0:3)
        (q, r) = divmod(n + i, d)
        earlier = earlier + 1
    Next i
EndSub
Sub skipped
    If d != 0 Then
        (q, r) = divmod(n, d)
    EndIf
    earlier = earlier + 1
EndSub
Sub expressionAlias
    (n, d) = divmod(n + 1, d + 1)
EndSub
Sub literalZero
    earlier = earlier + 1
    (q, r) = divmod(65535, 0)
    earlier = earlier + 1
EndSub
Sub literalPair
    (q, r) = divmod(100, 7)
EndSub
