// Shared scalar foundation; planner output is not executable yet.
uint16 calls = 0
uint16 amount Bounds(0, 100) = 3
uint16 accumulated = 0
float32 input Bounds(-8, 8) = 2.0
float32 scale Bounds(0, 4) = 1.5
float32 bias Bounds(-1, 1) = 0.25
float32 output Bounds(-33, 33) = 0.0

Sub advance
    calls = calls + 1
    accumulated = accumulated + amount * 2
EndSub

Sub compute
    output = input * scale + bias
EndSub
