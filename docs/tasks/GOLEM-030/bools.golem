// Boolean fields are interleaved with explicitly initialized numeric globals.
bool flag = false
uint16 a = 0
bool saved = true
uint16 b = 0
uint16 result = 99
uint16 earlier = 7
uint16 i = 0
bool spare = false

Sub equal
    earlier = earlier + 1
    flag = a == b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub unequal
    earlier = earlier + 1
    flag = a != b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub less
    earlier = earlier + 1
    flag = a < b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub greater
    earlier = earlier + 1
    flag = a > b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub atMost
    earlier = earlier + 1
    flag = a <= b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub atLeast
    earlier = earlier + 1
    flag = a >= b
    saved = flag
    If saved Then
        result = 11
    Else
        result = 22
    EndIf
    earlier = earlier + 1
EndSub

Sub copyLiteral
    flag = true
    saved = flag
    spare = false
    flag = saved
    If spare Then
        result = 1
    ElseIf saved Then
        result = 2
    Else
        result = 3
    EndIf
EndSub
Sub flagBranch
    If flag Then
        result = 11
    ElseIf saved Then
        result = 22
    Else
        result = 33
    EndIf
EndSub
Sub failure
    earlier = earlier + 1
    flag = a + 1 < b - 1
    saved = flag
    earlier = earlier + 1
EndSub
Sub loopFlags
    For i In Range(0:3)
        flag = i < b
        saved = flag
        If saved Then
            result = result + 1
        EndIf
    Next i
    spare = true
EndSub
Sub skipped
    If flag Then
        saved = a + 1 == b
    Else
        saved = false
    EndIf
    earlier = earlier + 1
EndSub
Sub constants
    flag = 65535 == 65535
    saved = 0 != 65535
    spare = true
    If false Then
        result = a + 1
    EndIf
EndSub
Sub invert
    flag = Not saved
EndSub
Sub conjunction
    spare = flag And saved
EndSub
Sub disjunction
    spare = flag Or saved
EndSub
Sub precedence
    spare = flag Or saved And Not (a == b)
EndSub
Sub grouped
    spare = (flag Or saved) And Not (a == b)
EndSub
Sub skipAnd
    earlier = earlier + 1
    spare = flag And a + 1 == b
    result = result + 1
EndSub
Sub skipOr
    earlier = earlier + 1
    spare = flag Or b - 1 == a
    result = result + 1
EndSub
Sub nested
    earlier = earlier + 1
    spare = (flag And (saved Or a + 1 == b)) Or (Not flag And b - 1 == a)
    result = result + 1
EndSub
Sub numericParens
    spare = (a + 1) < b And Not false
EndSub
Sub doubleNot
    spare = Not Not flag
EndSub
