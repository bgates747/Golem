// Assembly loads assets/wolf-review.agnb before invoking golem_drawWolf.
// Build reserves 8195:8195, 8201:8202 and 8463:8463; full 16-bit bitmap IDs.
// Assembly sets a black 320x240 display, origin (0,0) and full viewport.
uint16 bitmapBuffer Bounds(1,65534) = 8202
sint16 x = 0
sint16 y = 0
Sub drawWolf
    draw_bitmap(bitmapBuffer, x, y)
    draw_bitmap(8195, 16, 184)
    draw_bitmap(8463, 96, 168)
    draw_bitmap(8201, 200, 190)
EndSub
